@unpublished{tiwari2025_indian_skills,
  title     = {The Indian Skills Database and Taxonomy},
  author    = {Tiwari, Prateek and Mani, Deepa and Chadha, Nishant},
  year      = {2025},
  note      = {Working Paper},
  abstract  = {This paper develops a national-scale labour market database and skill taxonomy for India using high-frequency job-posting data. The approach combines LLM- and NLP-based extraction with systematic alignment across occupational and skill classifications, including NCO, NIC, O*NET, and Lightcast, enabling granular analysis of skill demand and occupational change.},
  selected  = {true}
}

@unpublished{tiwari2025_skill_value,
  title     = {Skill Value Prediction Using Job Postings Data},
  author    = {Munipalle, Sai Nikhila, Mani, Deepa and Tiwari, Prateek},
  year      = {2025},
  note      = {Working Paper},
  abstract  = {This paper proposes a framework for estimating the market value of individual and compositional job skills using job-posting data. The methodology combines regression-based approaches with deep learning architectures, including composition-aware skill embeddings and graph-based models, to estimate skill premiums across occupations.},
  selected  = {true}
}

